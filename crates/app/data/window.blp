using Gtk 4.0;
using Adw 1;

template $CardsWindow: Adw.ApplicationWindow {
  title: _("Cards");
  default-width: 640;
  default-height: 560;
  width-request: 360;
  height-request: 294;

  content: Adw.ToastOverlay toast_overlay {
    // One page per startup outcome; window.rs picks the visible one.
    child: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "main";

        // The deck list pushes deck pages onto this view.
        child: Adw.NavigationView navigation_view {
          $CardsDecksPage decks_page {}
        };
      }

      Gtk.StackPage {
        name: "recovery";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: $CardsRecoveryPage recovery_page {};
        };
      }

      Gtk.StackPage {
        name: "too-new";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage too_new_page {
            icon-name: "software-update-available-symbolic";
            title: _("Update Cards to Continue");

            child: Gtk.Label too_new_path {
              wrap: true;
              wrap-mode: word_char;
              selectable: true;
              justify: center;

              styles [
                "dim-label",
              ]
            };
          };
        };
      }

      Gtk.StackPage {
        name: "error";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage error_page {
            icon-name: "dialog-error-symbolic";
            title: _("Cards Could Not Start");

            child: Gtk.Label error_details {
              wrap: true;
              wrap-mode: word_char;
              selectable: true;
              justify: center;

              styles [
                "dim-label",
              ]
            };
          };
        };
      }
    };
  };
}
