using Gtk 4.0;

// One card in the deck page's list (ADR 0042): the front as the title, the
// back and the tags as the line under it, an icon when the card is
// suspended and a menu. Laid out like an action row through the classes
// libadwaita styles in any row (`row > box.header > box.title`, `.title`,
// `row label.subtitle`), as the deck rows are (ADR 0041). The texts are set
// in widgets/card_row.rs; card content and tag names are untrusted, so no
// label here parses markup.
template $RappelCardRow: Gtk.Box {
  styles [
    "header",
    "card-row",
  ]

  Gtk.Box {
    orientation: vertical;
    hexpand: true;
    valign: center;

    styles [
      "title",
    ]

    // The front, on one line: its plain summary, never markup.
    Gtk.Label front_label {
      use-markup: false;
      single-line-mode: true;
      ellipsize: end;
      xalign: 0;

      styles [
        "title",
      ]
    }

    // The back, dimmed and smaller (libadwaita's `row label.subtitle`), and
    // the tags at the end of the line. The back gives way first: the pills
    // keep their width, and the back ends in "…".
    Gtk.Box detail_box {
      spacing: 12;

      Gtk.Label back_label {
        use-markup: false;
        single-line-mode: true;
        ellipsize: end;
        xalign: 0;
        hexpand: true;

        styles [
          "subtitle",
        ]
      }

      // Not focusable: the row's accessible label says the tags.
      $RappelTagPills tag_pills {
        single-line: true;
        valign: center;
      }
    }
  }

  // A suspended card is not studied (ADR 0035). The icon has the word as
  // its tooltip and accessible label; the row's label says it too.
  Gtk.Image suspended_icon {
    visible: false;
    icon-name: "media-playback-pause-symbolic";
    tooltip-text: _("Suspended");
    valign: center;

    accessibility {
      label: _("Suspended");
    }

    styles [
      "dimmed",
    ]
  }

  Gtk.MenuButton menu_button {
    icon-name: "view-more-symbolic";
    tooltip-text: _("Card Actions");
    valign: center;
    // The menu is given on first use (widgets/card_row.rs,
    // `ui::rows::menu_on_demand`).

    styles [
      "flat",
    ]
  }
}

menu card_menu {
  section {
    item (_("_Edit…"), "row.edit")
    item (_("Card _Information"), "row.info")
  }

  // Suspend and Unsuspend share a place: the one that does nothing for the
  // bound card is disabled by the row and hidden by its menu.
  section {
    item {
      label: _("_Suspend");
      action: "row.suspend";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Unsuspend");
      action: "row.unsuspend";
      hidden-when: "action-disabled";
    }

    item (_("_Reset Progress"), "row.reset")
    item (_("_Delete"), "row.delete")
  }
}
