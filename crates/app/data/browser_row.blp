using Gtk 4.0;

// One card in the All Cards list. The texts are set in
// widgets/browser_row.rs; card content is untrusted, so markup is off.
// A check button shows only while cards are being chosen; it only shows the
// state (the row itself is what is activated).
template $RappelBrowserRow: Gtk.Box {
  spacing: 12;

  Gtk.CheckButton check {
    visible: false;
    can-target: false;
    focusable: false;
    valign: center;
  }

  Gtk.Box {
    orientation: vertical;
    hexpand: true;
    valign: center;
    spacing: 2;

    Gtk.Label front_label {
      use-markup: false;
      single-line-mode: true;
      ellipsize: end;
      xalign: 0;
    }

    // Wide rows only.
    Gtk.Label back_label {
      visible: false;
      use-markup: false;
      single-line-mode: true;
      ellipsize: end;
      xalign: 0;

      styles [
        "dim-label",
      ]
    }

    Gtk.Label caption_label {
      use-markup: false;
      single-line-mode: true;
      ellipsize: end;
      xalign: 0;

      styles [
        "caption",
        "dim-label",
      ]
    }
  }

  Gtk.MenuButton menu_button {
    icon-name: "view-more-symbolic";
    tooltip-text: _("Card Actions");
    valign: center;
    menu-model: browse_menu;

    styles [
      "flat",
    ]
  }
}

// Suspend and Unsuspend share a place: the one that does nothing for the
// bound card is disabled by the row and hidden by its menu.
menu browse_menu {
  section {
    item (_("_Edit…"), "row.edit")
    item (_("Card _Information"), "row.info")
  }

  section {
    item {
      label: _("_Suspend");
      action: "row.suspend";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Unsuspend");
      action: "row.unsuspend";
      hidden-when: "action-disabled";
    }

    item (_("_Reset Progress"), "row.reset")
    item (_("_Delete"), "row.delete")
  }
}
