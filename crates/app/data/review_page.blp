using Gtk 4.0;
using Adw 1;

// A study session of one deck. Texts are set in pages/review_page.rs; the
// front and back boxes are filled by render/ (ADR 0019), which escapes the
// untrusted card content.
template $RappelReviewPage: Adw.NavigationPage {
  title: _("Study");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {};

      [end]
      Gtk.Button edit_button {
        visible: false;
        icon-name: "document-edit-symbolic";
        action-name: "review.edit";
        tooltip-text: _("Edit Card (E)");

        accessibility {
          label: _("Edit Card");
        }
      }
    }

    content: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "card";

        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 600;
            margin-top: 36;
            margin-bottom: 36;
            margin-start: 18;
            margin-end: 18;

            // Focusable, so the keyboard focus can rest here and Space,
            // Enter, 1 and 2 reach the page's shortcuts.
            child: Gtk.Box card_area {
              orientation: vertical;
              spacing: 24;
              focusable: true;

              // Its accessible label is the front's text, and its
              // description the back's once shown (set in the page).
              Gtk.Box front_box {
                orientation: vertical;
              }

              Gtk.Separator back_separator {
                visible: false;
              }

              Gtk.Box back_box {
                orientation: vertical;
                visible: false;
              }

              // Shown when a side is longer than the review page lays out
              // (`render::MAX_SHOWN_BYTES`). Screen readers get the same
              // text with the side (`CUT_NOTE` in the page).
              Gtk.Label cut_note {
                label: _("This card is long: only its start is shown. Edit it to see all of it.");
                visible: false;
                wrap: true;
                xalign: 0;

                styles [
                  "dim-label",
                  "caption",
                ]
              }
            };
          };
        };
      }

      Gtk.StackPage {
        name: "summary";

        child: Adw.StatusPage summary_page {
          icon-name: "emblem-ok-symbolic";
          title: _("Session Complete");

          child: Gtk.Button done_button {
            label: _("_Back to Deck");
            use-underline: true;
            action-name: "review.done";
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }
    };

    [bottom]
    Gtk.Stack buttons {
      transition-type: crossfade;
      margin-top: 12;
      margin-bottom: 18;
      margin-start: 18;
      margin-end: 18;

      Gtk.StackPage {
        name: "reveal";

        child: Gtk.Button {
          label: _("_Show Answer");
          use-underline: true;
          action-name: "review.reveal";
          tooltip-text: _("Show Answer (Space)");
          halign: center;

          styles [
            "pill",
            "suggested-action",
          ]
        };
      }

      Gtk.StackPage {
        name: "grade";

        child: Gtk.Box {
          spacing: 12;
          halign: center;
          homogeneous: true;

          Gtk.Button {
            label: _("_Fail");
            use-underline: true;
            action-name: "review.fail";
            tooltip-text: _("Fail (1)");

            styles [
              "pill",
            ]
          }

          Gtk.Button {
            label: _("_Pass");
            use-underline: true;
            action-name: "review.pass";
            tooltip-text: _("Pass (2 or Space)");

            styles [
              "pill",
              "suggested-action",
            ]
          }
        };
      }

      Gtk.StackPage {
        name: "none";

        child: Gtk.Box {};
      }
    }
  };
}
