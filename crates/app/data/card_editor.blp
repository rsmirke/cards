using Gtk 4.0;
using Adw 1;
using GtkSource 5;

// The card editor. The title ("New Card" / "Edit Card") and the texts are
// set in dialogs/card_editor/mod.rs, and so are the buffers' Markdown
// language and style scheme. The preview sits beside the sources when the
// dialog is wide, below them when it is narrow (the breakpoint).
template $RappelCardEditor: Adw.Dialog {
  content-width: 960;
  content-height: 640;
  // libadwaita asks for a minimum size on a dialog with breakpoints; this
  // is the main window's own (window.blp).
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 720sp")

    setters {
      main_box.orientation: vertical;
      preview_separator.orientation: horizontal;
    }
  }

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button {
        label: _("_Cancel");
        use-underline: true;
        action-name: "editor.cancel";
      }

      [end]
      Gtk.Button save_button {
        label: _("_Save");
        use-underline: true;
        action-name: "editor.save";
        tooltip-text: _("Save (Ctrl+Enter)");

        styles [
          "suggested-action",
        ]
      }

      [end]
      Gtk.ToggleButton preview_button {
        icon-name: "view-dual-symbolic";
        tooltip-text: _("Preview");
        active: true;

        accessibility {
          label: _("Preview");
        }
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Gtk.Box main_box {
        orientation: horizontal;

        Gtk.Box {
          orientation: vertical;
          spacing: 6;
          hexpand: true;
          vexpand: true;
          margin-top: 6;
          margin-bottom: 18;
          margin-start: 18;
          margin-end: 18;

          Gtk.Label front_label {
            label: _("Front");
            xalign: 0;

            styles [
              "heading",
            ]
          }

          // A frame, not a card: GtkFrame clips its child to its rounded
          // corners (`gtk_frame_init` sets overflow hidden), and libadwaita
          // draws it as a 1 px border that follows light, dark and high
          // contrast. A card on the scroller had its corners painted over by
          // the view's square background, cutting its shadow. The background
          // is the Adwaita style scheme's (the view colour; mod.rs). No
          // `inline` class: libadwaita 1.10's style-class docs say it "cannot
          // be used with GtkSourceView"
          // (gnome.pages.gitlab.gnome.org/libadwaita/doc/1.10/style-classes.html).
          Gtk.Frame {
            child: Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              min-content-height: 96;
              vexpand: true;

              child: GtkSource.View front_view {
                buffer: GtkSource.Buffer front_buffer {};
                monospace: true;
                wrap-mode: word_char;
                accepts-tab: false;
                top-margin: 12;
                bottom-margin: 12;
                left-margin: 12;
                right-margin: 12;

                accessibility {
                  labelled-by: front_label;
                  described-by: front_error;
                }
              };
            };
          }

          Gtk.Label front_error {
            visible: false;
            wrap: true;
            xalign: 0;

            styles [
              "error",
              "caption",
            ]
          }

          Gtk.Label back_label {
            label: _("Back");
            xalign: 0;
            margin-top: 12;

            styles [
              "heading",
            ]
          }

          Gtk.Frame {
            child: Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              min-content-height: 96;
              vexpand: true;

              child: GtkSource.View back_view {
                buffer: GtkSource.Buffer back_buffer {};
                monospace: true;
                wrap-mode: word_char;
                accepts-tab: false;
                top-margin: 12;
                bottom-margin: 12;
                left-margin: 12;
                right-margin: 12;

                accessibility {
                  labelled-by: back_label;
                  described-by: back_error;
                }
              };
            };
          }

          Gtk.Label back_error {
            visible: false;
            wrap: true;
            xalign: 0;

            styles [
              "error",
              "caption",
            ]
          }
        }

        Gtk.Separator preview_separator {
          orientation: vertical;
          visible: bind preview_button.active;
        }

        // Not focusable: the rendered labels are not (see render/mod.rs),
        // so Tab goes from the back straight to the header buttons.
        Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          hexpand: true;
          vexpand: true;
          visible: bind preview_button.active;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            margin-top: 6;
            margin-bottom: 18;
            margin-start: 18;
            margin-end: 18;

            Gtk.Label preview_label {
              label: _("Preview");
              xalign: 0;

              styles [
                "heading",
              ]
            }

            Gtk.Label preview_note {
              label: _("This card is long: only its start is previewed.");
              visible: false;
              wrap: true;
              xalign: 0;

              styles [
                "dim-label",
                "caption",
              ]
            }

            // Laid out like the review page's card: the front, then the
            // back under a separator when it has something to show.
            Gtk.Box {
              orientation: vertical;
              spacing: 24;
              accessible-role: group;

              accessibility {
                labelled-by: preview_label;
              }

              Gtk.Box preview_front {
                orientation: vertical;
              }

              Gtk.Separator preview_back_separator {
                visible: false;
              }

              Gtk.Box preview_back {
                orientation: vertical;
                visible: false;
              }
            }
          };
        }
      };
    };
  };
}
