using Gtk 4.0;
using Adw 1;

// The card editor. The title ("New Card" / "Edit Card") and the texts are
// set in dialogs/card_editor.rs. Front and back are plain text for now;
// Markdown highlighting and preview come with the editor slice (SPEC §4.4).
template $RappelCardEditor: Adw.Dialog {
  content-width: 560;
  content-height: 520;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button {
        label: _("_Cancel");
        use-underline: true;
        action-name: "editor.cancel";
      }

      [end]
      Gtk.Button save_button {
        label: _("_Save");
        use-underline: true;
        action-name: "editor.save";
        tooltip-text: _("Save (Ctrl+Enter)");

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Gtk.Box {
        orientation: vertical;
        spacing: 6;
        margin-top: 6;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        Gtk.Label front_label {
          label: _("Front");
          xalign: 0;

          styles [
            "heading",
          ]
        }

        Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          min-content-height: 96;
          vexpand: true;

          styles [
            "card",
          ]

          child: Gtk.TextView front_view {
            wrap-mode: word_char;
            accepts-tab: false;
            top-margin: 12;
            bottom-margin: 12;
            left-margin: 12;
            right-margin: 12;

            accessibility {
              labelled-by: front_label;
              described-by: front_error;
            }

            styles [
              "inline",
            ]
          };
        }

        Gtk.Label front_error {
          visible: false;
          wrap: true;
          xalign: 0;

          styles [
            "error",
            "caption",
          ]
        }

        Gtk.Label back_label {
          label: _("Back");
          xalign: 0;
          margin-top: 12;

          styles [
            "heading",
          ]
        }

        Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          min-content-height: 96;
          vexpand: true;

          styles [
            "card",
          ]

          child: Gtk.TextView back_view {
            wrap-mode: word_char;
            accepts-tab: false;
            top-margin: 12;
            bottom-margin: 12;
            left-margin: 12;
            right-margin: 12;

            accessibility {
              labelled-by: back_label;
              described-by: back_error;
            }

            styles [
              "inline",
            ]
          };
        }

        Gtk.Label back_error {
          visible: false;
          wrap: true;
          xalign: 0;

          styles [
            "error",
            "caption",
          ]
        }
      };
    };
  };
}
